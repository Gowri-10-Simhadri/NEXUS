# ─── Server Configuration ───────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ─── MongoDB Atlas (Required for persistence) ───────────
MONGODB_URI=mongodb://localhost:27017/nexus

# ─── JWT Secrets ─────────────────────────────────────────
JWT_SECRET=nexus_super_secret_jwt_access_token_key_change_in_prod_12345
JWT_REFRESH_SECRET=nexus_super_secret_jwt_refresh_token_key_change_in_prod_67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI Providers (Gemini / OpenAI) ──────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── GitHub OAuth (Optional) ─────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/integrations/github/callback

# ─── Web Push (VAPID) ────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:support@nexus.app

# ─── Email SMTP (Optional) ───────────────────────────────
EMAIL_FROM="NEXUS Intelligence" <noreply@nexus.app>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Desktop Agent ───────────────────────────────────────
DESKTOP_APP_SECRET=nexus_desktop_agent_shared_secret_2026
